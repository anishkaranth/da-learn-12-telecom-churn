-- da-learn-12 Telecom customer churn - DAX measures
-- Home table: fact_subscription unless the measure names fact_service. Matches results/ (DuckDB): churn rate = churned / customers,
-- MRR lost = MonthlyCharges of churned customers, lifetime revenue = TotalCharges to date.
Customers = COUNTROWS ( fact_subscription )
Churned Customers = SUM ( fact_subscription[churned] )
Retained Customers = [Customers] - [Churned Customers]
Churn Rate % = DIVIDE ( [Churned Customers], [Customers] )
Retention Rate % = 1 - [Churn Rate %]
MRR = SUM ( fact_subscription[monthly_charges] )
MRR Lost = SUM ( fact_subscription[mrr_lost] )
MRR Lost % = DIVIDE ( [MRR Lost], [MRR] )
Annualised Revenue Lost = SUM ( fact_subscription[annualised_revenue_lost] )
Avg Monthly Charge = AVERAGE ( fact_subscription[monthly_charges] )
Avg Monthly Charge Churned = CALCULATE ( [Avg Monthly Charge], fact_subscription[churned] = 1 )
Avg Monthly Charge Retained = CALCULATE ( [Avg Monthly Charge], fact_subscription[churned] = 0 )
Lifetime Revenue = SUM ( fact_subscription[total_charges] )
Avg Lifetime Revenue = AVERAGE ( fact_subscription[total_charges] )
Avg Lifetime Revenue Churned = CALCULATE ( [Avg Lifetime Revenue], fact_subscription[churned] = 1 )
Avg Tenure Months = AVERAGE ( fact_subscription[tenure_months] )
Median Tenure Churned = CALCULATE ( MEDIAN ( fact_subscription[tenure_months] ), fact_subscription[churned] = 1 )
Median Tenure Retained = CALCULATE ( MEDIAN ( fact_subscription[tenure_months] ), fact_subscription[churned] = 0 )
Customer Share % = DIVIDE ( [Customers], CALCULATE ( [Customers], ALL ( fact_subscription ) ) )
Churner Share % = DIVIDE ( [Churned Customers], CALCULATE ( [Churned Customers], ALL ( fact_subscription ) ) )
MRR Lost Share % = DIVIDE ( [MRR Lost], CALCULATE ( [MRR Lost], ALL ( fact_subscription ) ) )
Churn Rate vs Average (pts) = [Churn Rate %] - CALCULATE ( [Churn Rate %], ALL ( fact_subscription ), ALL ( dim_contract ), ALL ( dim_payment ), ALL ( dim_demographics ), ALL ( dim_services ), ALL ( dim_tenure_band ) )
Month-to-month Churn Rate % = CALCULATE ( [Churn Rate %], dim_contract[contract] = "Month-to-month" )
Two-year Churn Rate % = CALCULATE ( [Churn Rate %], dim_contract[contract] = "Two year" )
Charges Mismatch Customers = CALCULATE ( [Customers], fact_subscription[dq_charges_mismatch] = 1 )
-- add-on effect (use on a page filtered to internet customers: dim_services[has_internet] = 1)
Churn Rate With Tech Support % = CALCULATE ( [Churn Rate %], dim_services[has_tech_support] = 1 )
Churn Rate Without Tech Support % = CALCULATE ( [Churn Rate %], dim_services[has_tech_support] = 0, dim_services[has_internet] = 1 )
Churn Rate With Online Security % = CALCULATE ( [Churn Rate %], dim_services[has_online_security] = 1 )
Churn Rate Without Online Security % = CALCULATE ( [Churn Rate %], dim_services[has_online_security] = 0, dim_services[has_internet] = 1 )
-- service-line grain (fact_service)
Service Subscribers = COUNTROWS ( fact_service )
Service Adoption % = DIVIDE ( [Service Subscribers], CALCULATE ( [Customers], ALL ( fact_subscription ) ) )
Service Churn Rate % = DIVIDE ( SUM ( fact_service[churned] ), [Service Subscribers] )
